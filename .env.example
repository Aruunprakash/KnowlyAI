# Google AI Studio key used for both embeddings and generation.
GOOGLE_API_KEY=your-key-here

# --- Optional: all have sensible defaults ---
# KNOWLY_STORAGE_DIR=storage          # uploaded PDFs + the document manifest
# KNOWLY_CHROMA_DIR=chroma_db         # vector store on disk
# KNOWLY_COLLECTION=knowlyai_documents
# KNOWLY_TOP_K=4                      # chunks retrieved per question
# KNOWLY_MAX_UPLOAD_BYTES=52428800    # 50 MB
# KNOWLY_CORS_ORIGINS=http://localhost:5173,http://localhost:4512,http://127.0.0.1:4512
