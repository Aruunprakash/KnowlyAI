# Base URL of the KnowlyAI API. Leave empty to use the dev proxy / same origin.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Set to "true" to run the UI against in-memory fixtures with no Python backend.
VITE_MOCK_API=false
